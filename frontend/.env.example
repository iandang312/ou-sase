# OU SASE — environment template
#
# Copy to .env.local and fill in. .env.local is gitignored; never commit real keys.
#
# ACCOUNT PORTABILITY (important for handing the site to SASE later):
# nothing below is hardcoded anywhere in the source. When the chapter moves to
# an official SASE Google/Cloudinary account, you create the new projects, swap
# these values in the deployment settings, and redeploy. No code changes.
# Full walkthrough: HANDOFF.md

# --- Firebase (client SDK; these are public by design, secured by rules) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Cloudinary -------------------------------------------------------------
# Cloud name is public (used to build image URLs in the browser).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# NOTE: no unsigned upload preset is used any more. Uploads go through
# /api/cloudinary/sign, which requires an active exec's Firebase token.
# If you created an unsigned preset earlier, DELETE it in the Cloudinary
# console: an unsigned preset plus the cloud name is a public write
# endpoint into your media library, and both values are visible in the
# browser bundle.
# SECRET. Server-side only — signing uploads and deletes. Never prefix NEXT_PUBLIC_.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Firebase Admin (SERVER ONLY) ------------------------------------------
# Verifies that whoever calls /api/cloudinary/sign is a real, active exec.
# These are SECRET. Never prefix with NEXT_PUBLIC_.
# From: Firebase console -> Project settings -> Service accounts ->
# Generate new private key.
# The private key MUST be one line, in double quotes, with each newline
# written as the two characters backslash-n. A real line break here breaks parsing.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""
